.splash .favorite li:nth-of-type(2n+2) a:hover::before {
  content: " 👓  ";
  color: transparent !important;
  text-shadow: 0 0 0 #CFDAE3;
}

.splash .favorite {
  position: relative;
  padding-bottom: 22px;
}

.splash .favorite::before {
  content: "";
  position: absolute;
  right: 0;
  top: 50%;
  transform: translateY(-30%);
  width: 55px;
  height: 100px;
  background-image: url("https://64.media.tumblr.com/6114155b4dd5352fd33e540f32b357d0/f05f3df342fc78d7-aa/s1280x1920/d62489394518596e26b0a00d0e89064fa9550912.png");
  background-size: contain;
  background-repeat: no-repeat;
  background-position: center;
}

.splash .favorite {
  position: relative;
}

.splash .favorite::after {
  content: " ℑ𝔣 𝔶𝔬𝔲 𝔱𝔴𝔬 𝔞𝔯𝔢 𝔱𝔥𝔢 𝔧𝔬𝔨𝔢𝔰 𝔱𝔥𝔢𝔫 ℑ'𝔪 𝔱𝔥𝔢 𝔓𝔲𝔫𝔠𝔥𝔩𝔦𝔫𝔢. ℑ'𝔪 𝔴𝔥𝔢𝔯𝔢 𝔶𝔬𝔲 𝔢𝔫𝔡. ";
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  transform: translateY(15px);
  border-radius: 10px;
  background: rgba(12, 11, 15, 0.7);
  text-align: center;
  font-size: 12px;
  color: #E1D1DE;
  opacity: 1;
  white-space: pre;
}

